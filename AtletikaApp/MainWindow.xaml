<Window x:Class="AtletikaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlétikai verseny - Rajtszámok" Width="1440" Height="820"
        MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D4DDE7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#52657A"/>
      <Setter Property="Margin" Value="0,10,0,5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#19324D"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="BorderBrush" Value="#C6D3E1"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="DeepBlueTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#19324D"/>     
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
      <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Új versenyző" Style="{StaticResource DeepBlueTextBlock}"/>
              <TextBlock Text="Versenyző neve:" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="txtNev" Height="32" VerticalContentAlignment="Center"/>
              <TextBlock Text="Versenyszám:" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="cmbVersenyszam" Height="32" IsEditable="False" SelectedIndex="-1">
                <ComboBoxItem Content="100 m"/>
                <ComboBoxItem Content="200 m"/>
                <ComboBoxItem Content="400 m"/>
                <ComboBoxItem Content="800 m"/>
                <ComboBoxItem Content="1500 m"/>
                <ComboBoxItem Content="Távolugrás"/>
                <ComboBoxItem Content="Magasugrás"/>
                <ComboBoxItem Content="Súlylökés"/>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Margin="0, 10">
                <TextBlock Text="Nem:"  VerticalAlignment="Center"/>
                <RadioButton x:Name="rbFerfi" Content="Férfi" GroupName="Nem" Margin="50,0,50,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="rbNo" Content="Nő" GroupName="Nem" VerticalAlignment="Center"/>
              </StackPanel>
              <DockPanel Margin="0,10,0,5">
                <TextBlock Text="Életkor:"  />
                <TextBlock x:Name="txtEletkor" Grid.Column="1" Text="18 év" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="DarkCyan" FontWeight="Bold"/>
              </DockPanel>
              <Slider x:Name="sldEletkor" Minimum="18" Maximum="90" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="Eletkor_Valtozott"/>
              <DockPanel>
                <TextBlock Text="18" Foreground="#52657A"/>
                <TextBlock Text="90" DockPanel.Dock="Right" Foreground="#52657A" TextAlignment="Right"/>
              </DockPanel>
              <TextBlock Text="Korábbi eredmények" Style="{StaticResource DeepBlueTextBlock}" FontSize="16" Margin="0, 10, 0, 5"/>
              <CheckBox x:Name="chkOR" Content="Olimpiai csúcs (OR)" Margin="0,3"/>
              <CheckBox x:Name="chkVR" Content="Világcsúcs (VR)" Margin="0,3"/>
              <CheckBox x:Name="chkER" Content="Európa-csúcs (ER)" Margin="0,3"/>
              <TextBlock Text="Igényelt rajtszám" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="txtRajtszam" Height="32" VerticalContentAlignment="Center"/>
              <TextBlock Text="Üres mező: automatikus kiosztás." Foreground="#52657A" FontSize="12" Margin="0,5,0,12"/>
            </StackPanel>
          </ScrollViewer>
          <Button x:Name="btnRegisztral" Grid.Row="1" Content="REGISZTRÁL" Height="36" Background="#DDEBFA" Margin="0,12,0,0" Click="Regisztral_Click"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
        <Grid>
          <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="220"/>
              </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Regisztrált versenyzők" Style="{StaticResource DeepBlueTextBlock}"/>
                <TextBlock Text="Rajtszám | név | versenyszám | nem | életkor | OR | VR | ER" Foreground="#52657A" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Eredményszűrő" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="#52657A"/>
            <ComboBox x:Name="cmbRekordSzuro" Grid.Column="2" Height="32" VerticalAlignment="Center" IsEditable="False" SelectedIndex="0" SelectionChanged="Szuro_Valtozott">
              <ComboBoxItem Content="Összes"/>
              <ComboBoxItem Content="OR - olimpiai csúcs"/>
              <ComboBoxItem Content="VR - világcsúcs"/>
              <ComboBoxItem Content="ER - Európa-csúcs"/>
            </ComboBox>
          </Grid>
          <DataGrid x:Name="dgVersenyzok" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserReorderColumns="False" HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Single"
                    RowHeight="32" AlternatingRowBackground="#F4F7FB" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E7EF"
                    BorderBrush="#D4DDE7" BorderThickness="1" ItemsSource="{Binding Versenyzok, Mode=OneWay}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#19324D"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Height" Value="38"/>
                </Style></DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Rajtszám" Binding="{Binding Rajtszam, Mode=OneWay}" Width="88"/>
              <DataGridTextColumn Header="Név" Binding="{Binding Nev, Mode=OneWay}" Width="*"/>
              <DataGridTextColumn Header="Versenyszám" Binding="{Binding Versenyszam, Mode=OneWay}" Width="160"/>
              <DataGridTextColumn Header="Nem" Binding="{Binding Nem, Mode=OneWay}" Width="70"/>
              <DataGridTextColumn Header="Életkor" Binding="{Binding Eletkor, Mode=OneWay}" Width="80"/>
              <DataGridCheckBoxColumn Header="OR" Binding="{Binding OR, Mode=OneWay}" Width="80"/>
              <DataGridCheckBoxColumn Header="VR" Binding="{Binding VR, Mode=OneWay}" Width="80"/>
              <DataGridCheckBoxColumn Header="ER" Binding="{Binding ER, Mode=OneWay}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="OR = olimpiai csúcs    VR = világcsúcs    ER = Európa-csúcs" Foreground="#52657A" FontSize="12" Margin="0,10,0,0"/>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="210"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="210"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="txtLetszam" Text="Látható: 0 / Összesen: 0" VerticalAlignment="Center" Foreground="#19324D" FontWeight="SemiBold"/>
        <Button x:Name="btnMentes" Grid.Column="1" Content="FÁJLBA MENTÉS" Height="32" Click="Mentes_Click"/>
        <Button x:Name="btnBetoltes" Grid.Column="3" Content="FÁJLBÓL BETÖLTÉS" Height="32" Click="Betoltes_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
